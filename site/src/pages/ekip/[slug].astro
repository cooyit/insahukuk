---
import type { GetStaticPaths } from 'astro';
import KisiSayfasi from '../../components/KisiSayfasi.astro';
import { kisiDetaylariGetir, type KisiDetay } from '../../lib/veri';

// Yalnizca aktif kisiler icin sayfa uretilir (kural veri modulunde).
export const getStaticPaths = (async () => {
  const kisiler = await kisiDetaylariGetir('tr');
  return kisiler.map((kisi) => ({ params: { slug: kisi.slug }, props: { kisi } }));
}) satisfies GetStaticPaths;

const { kisi } = Astro.props as { kisi: KisiDetay };
---

<KisiSayfasi dil="tr" kisi={kisi} />
