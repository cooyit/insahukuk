---
import type { GetStaticPaths } from 'astro';
import SabitSayfa from '../components/SabitSayfa.astro';
import { icerikSayfalariGetir, type SayfaIcerik } from '../lib/veri';

// Adres veriden gelir (sayfa_ceviri.slug): '/hakkimizda' -> params.sayfa = 'hakkimizda'.
// Ana sayfa ve iletisim burada uretilmez (kendi sablonlari var; liste veri modulunde).
export const getStaticPaths = (async () => {
  const sayfalar = await icerikSayfalariGetir('tr');
  return sayfalar.map((sayfa) => ({ params: { sayfa: sayfa.url.slice(1) }, props: { sayfa } }));
}) satisfies GetStaticPaths;

const { sayfa } = Astro.props as { sayfa: SayfaIcerik };
---

<SabitSayfa dil="tr" sayfa={sayfa} />
