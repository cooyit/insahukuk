---
import type { GetStaticPaths } from 'astro';
import SabitSayfa from '../../components/SabitSayfa.astro';
import { icerikSayfalariGetir, type SayfaIcerik } from '../../lib/veri';

// Adres veriden gelir (sayfa_ceviri.slug): '/en/about' -> params.sayfa = 'about'.
// Yalnizca EN cevirisi olan sayfalar; ana sayfa ve iletisim burada uretilmez.
export const getStaticPaths = (async () => {
  const sayfalar = await icerikSayfalariGetir('en');
  return sayfalar.map((sayfa) => ({ params: { sayfa: sayfa.url.replace(/^\/en\//, '') }, props: { sayfa } }));
}) satisfies GetStaticPaths;

const { sayfa } = Astro.props as { sayfa: SayfaIcerik };
---

<SabitSayfa dil="en" sayfa={sayfa} />
