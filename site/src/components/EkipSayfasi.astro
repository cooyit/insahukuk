---
// Ekip listesi (TR /ekip, EN /en/team). Yalnizca foto, ad ve unvan (docs/inceleme 6.3).
// Siralama veri modulunde: unvan sirasi, sonra unvan icindeki siralama.
import Temel from '../layouts/Temel.astro';
import KirintiYolu from './KirintiYolu.astro';
import KisiKarti from './KisiKarti.astro';
import { digerDil, metinler, type Dil } from '../lib/metinler';
import { ekibiGetir } from '../lib/veri';
import { yollar } from '../lib/yollar';

interface Props {
  dil: Dil;
}

const { dil } = Astro.props;
const m = metinler[dil];
const ekip = await ekibiGetir(dil);
---

<Temel baslik={m.ekip} aciklama={m.ekipAciklama} karsilik={yollar[digerDil(dil)].ekip}>
  <KirintiYolu dil={dil} ogeler={[{ ad: m.ekip }]} />
  <h1>{m.ekip}</h1>
  <ul class="kart-izgara">
    {ekip.map((kisi) => <KisiKarti kisi={kisi} />)}
  </ul>
</Temel>
