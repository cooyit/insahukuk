# Yerel gelistirme ayarlari. "npm run kur" bu dosyadan .env uretir ve __RASTGELE__ yerlerine
# rastgele deger yazar. .env depoya girmez (.gitignore). Canli sunucu icin ayri .env hazirlanir.

# --- PostgreSQL (panel/.veri altindaki projeye ozel kume) ---
# PostgreSQL 16 bin klasoru. Bos birakilirsa PATH'teki initdb/pg_ctl/psql kullanilir.
# macOS (Homebrew): /opt/homebrew/opt/postgresql@16/bin   Windows: C:\Program Files\PostgreSQL\16\bin
PG_BIN=/opt/homebrew/opt/postgresql@16/bin
PG_SUPER_SIFRE=__RASTGELE__

DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=54316
DB_DATABASE=insa
DB_USER=insa
DB_PASSWORD=__RASTGELE__

# --- Directus ---
PORT=8055
PUBLIC_URL=http://localhost:8055
SECRET=__RASTGELE__
ADMIN_EMAIL=yonetici@ornek.av.tr
ADMIN_PASSWORD=__RASTGELE__
# Directus'un anonim kullanim istatistigi kapali (KVKK; disari veri gitmesin).
# DIKKAT: lisanssiz "Core" katmaninda Directus bu ayari yok sayar (telemetry_required);
# kapanmasi lisans anahtari gerektirir. Bkz. docs/panel-gece-calismasi.md.
TELEMETRY=false
# Yapay zeka asistani ve MCP sunucusu kapali: icerik ucuncu taraf modele gitmesin (KVKK).
AI_ENABLED=false
MCP_ENABLED=false
# Bos: lisanssiz "Core" katmani. Open Innovation Grant anahtari gelince buraya yazilir.
LICENSE_KEY=

# --- Iletisim formu servisi (npm run form) ---
# Servis Directus'a "Form servisi" kullanicisinin bu anahtariyla yazar (yalnizca mesaj olusturur,
# panele giremez, mesaj okuyamaz). "npm run yapilandir" anahtari kullaniciya tanimlar.
FORM_DIRECTUS_TOKEN=__RASTGELE__
# IP adresi saklanmaz; bu anahtarla HMAC-SHA256'si saklanir (yalnizca spam siniri icin).
FORM_IP_ANAHTARI=__RASTGELE__
FORM_HOST=127.0.0.1
FORM_PORT=8065
# Formun gonderilebilecegi site adresleri (virgulle). Yerelde "astro dev"; canlida sitenin adresi.
FORM_IZINLI_KAYNAK=http://localhost:4321
# Canlida ters vekil (Caddy) arkasinda "evet": IP, X-Forwarded-For'un son degerinden okunur.
FORM_VEKIL_ARKASINDA=hayir
# IP basina en fazla FORM_HIZ_ADET deneme / FORM_HIZ_DAKIKA dakika.
FORM_HIZ_ADET=5
FORM_HIZ_DAKIKA=10

# --- E-posta (Directus: iletisim formu bildirimi, parola sifirlama) ---
# Yerelde gercek e-posta gitmez: "npm run posta" sahte SMTP alicisini acar; e-postalar
# panel/.veri/posta/ altina .eml dosyasi olarak yazilir.
# Canlida buronun e-posta saglayicisinin SMTP bilgileri yazilir: genellikle EMAIL_SMTP_PORT=465 ve
# EMAIL_SMTP_SECURE=true (ya da 587 ve EMAIL_SMTP_IGNORE_TLS=false), kullanici ve parola dolu.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=panel@insahukuk.test
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_IGNORE_TLS=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Akislar yalnizca bu listedeki ortam degiskenlerini gorur; bildirim e-postasindaki panel baglantisi icin.
FLOWS_ENV_ALLOW_LIST=PUBLIC_URL
