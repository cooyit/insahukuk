# Yerel gelistirme ayarlari. "npm run kur" bu dosyadan .env uretir ve __RASTGELE__ yerlerine
# rastgele deger yazar. .env depoya girmez (.gitignore). Canli sunucu icin ayri .env hazirlanir.

# --- PostgreSQL (panel/.veri altindaki projeye ozel kume) ---
# PostgreSQL 16 bin klasoru. Bos birakilirsa PATH'teki initdb/pg_ctl/psql kullanilir.
# macOS (Homebrew): /opt/homebrew/opt/postgresql@16/bin   Windows: C:\Program Files\PostgreSQL\16\bin
PG_BIN=/opt/homebrew/opt/postgresql@16/bin
PG_SUPER_SIFRE=__RASTGELE__

DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=54316
DB_DATABASE=insa
DB_USER=insa
DB_PASSWORD=__RASTGELE__

# --- Directus ---
PORT=8055
PUBLIC_URL=http://localhost:8055
SECRET=__RASTGELE__
ADMIN_EMAIL=yonetici@ornek.av.tr
ADMIN_PASSWORD=__RASTGELE__
# Directus'un anonim kullanim istatistigi kapali (KVKK; disari veri gitmesin).
# DIKKAT: lisanssiz "Core" katmaninda Directus bu ayari yok sayar (telemetry_required);
# kapanmasi lisans anahtari gerektirir. Bkz. docs/panel-gece-calismasi.md.
TELEMETRY=false
# Yapay zeka asistani ve MCP sunucusu kapali: icerik ucuncu taraf modele gitmesin (KVKK).
AI_ENABLED=false
MCP_ENABLED=false
# Bos: lisanssiz "Core" katmani. Open Innovation Grant anahtari gelince buraya yazilir.
LICENSE_KEY=
